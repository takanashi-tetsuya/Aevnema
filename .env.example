# ==========================================
# 机器人底层配置参数 (Bot Core Configuration)
# ==========================================

# ----------------------------------------
# 1. 基础服务配置
# ----------------------------------------
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
LOG_FILE_PATH="logs/bot.log"
ENABLE_TELEGRAM=true
# Whitelists are opt-in. When enabled, configure at least one stable-ID list.
TELEGRAM_WHITELIST_ENABLED=false
TELEGRAM_ALLOWED_USERS=""
TELEGRAM_ALLOWED_CHATS=""
TELEGRAM_GROUP_MODE=mentions
TELEGRAM_MAX_IMAGE_BYTES=10485760
SILICONFLOW_API_KEY="your_siliconflow_api_key"
MODEL_CONFIG_PATH="config/model_config.toml"
# Persistent per-platform-user overrides changed through /model.
USER_MODEL_SETTINGS_PATH="data/user_model_settings.json"

# Associative memory engine and three physically separated domains.
MEMORY_ENGINE_ROOT="../associative-memory"
KNOWLEDGE_MEMORY_DB_PATH="data/knowledge/blue_archive.db"
PUBLIC_MEMORY_DB_PATH="data/public/memory.db"
USER_MEMORY_DB_DIR="data/users"
CONVERSATION_INBOX_DIR="data/conversation_inbox"
MEMORY_LOG_DIR="logs/memory"
MEMORY_OPTIMIZATION_PROFILE=balanced
MEMORY_FOREGROUND_PROFILE=balanced
MEMORY_FOREGROUND_REASONING_MODEL=Qwen/Qwen3.5-9B
MEMORY_FOREGROUND_REASONING_MAX_TOKENS=1200
MEMORY_FOREGROUND_REASONING_ENABLE_THINKING=false
MEMORY_FOREGROUND_REVIEW_MODE=fast_adaptive
MEMORY_FOREGROUND_FOLLOWUP_PLANNING_MODE=entity_resolved
MEMORY_FOREGROUND_ATOMIC_QUERY_LIMIT=12
# Target before reranking; the final evidence floor can raise the effective
# input to the final evidence limit (currently 30).
MEMORY_FOREGROUND_RERANK_PRECOMPRESSION_LIMIT=24
MEMORY_RECALL_CACHE_SIZE=64
MEMORY_QUERY_EMBEDDING_CACHE_SIZE=512
MEMORY_RECALL_CACHE_TTL_SECONDS=900
MEMORY_SEMANTIC_PLAN_CACHE_SIZE=64
MEMORY_SEMANTIC_PLAN_CACHE_TTL_SECONDS=900
MEMORY_SEMANTIC_PLAN_CACHE_SIMILARITY=0.60
MEMORY_RECALL_FAILURE_TTL_SECONDS=60
# Domains with no more than this many Episodes skip LLM intent/rerank in the
# foreground. Set 0 to disable. Background growth never uses this shortcut.
MEMORY_SMALL_DB_FAST_PATH_MAX_EPISODES=32
MEMORY_PARAGRAPH_ENABLED=1
MEMORY_CONCEPT_PROFILE=fine_grained
MEMORY_IMPORT_EPISODE_PROFILE=source_scoped_plain
KNOWLEDGE_GROWTH_REASONING_MODEL=deepseek-ai/DeepSeek-V3.2
KNOWLEDGE_GROWTH_FALLBACK_MODEL=Qwen/Qwen3.5-35B-A3B
MEMORY_IMPORT_EPISODE_FACTUAL_AUDIT_MODE=off
MEMORY_SPARSE_ENABLED=1
MEMORY_SOURCE_KEY_COHORT_ENABLED=1
# Optional dedicated reranker. Leave empty to skip reranking completely;
# embedding, sparse, and Association retrieval remain enabled.
# With a model configured: light and standard queries use this cross-encoder;
# deep multi-hop queries use the original LLM evidence-coverage path. The
# small-database deterministic shortcut still skips remote reranking.
MEMORY_RERANKER_MODEL=
# Example:
# MEMORY_RERANKER_MODEL=Pro/BAAI/bge-reranker-v2-m3
MEMORY_RERANK_COVERAGE_AUDIT_ENABLED=1
MEMORY_GROWTH_PERSIST_ONLY_USED=1
MEMORY_GROWTH_COUNTERFACTUAL_UTILITY_ENABLED=1
MEMORY_GROWTH_STAGING_ENABLED=1
MEMORY_CONTEXTUAL_ASSOCIATION_ENABLED=0
MEMORY_CONTEXTUAL_ASSOCIATION_SHADOW=1
MEMORY_CONTEXTUAL_ASSOCIATION_ALLOW_NETWORK=0
MEMORY_CONTEXTUAL_ASSOCIATION_CONTEXT_TOP_K=8
MEMORY_CONTEXTUAL_ASSOCIATION_NEED_TOP_K=8
MEMORY_CONTEXTUAL_ASSOCIATION_EDGE_TOP_K=16
MEMORY_CONTEXTUAL_ASSOCIATION_CONTEXT_THRESHOLD=0.55
MEMORY_CONTEXTUAL_ASSOCIATION_NEED_THRESHOLD=0.55
MEMORY_CONTEXTUAL_ASSOCIATION_COMBINE_MODE=product
MEMORY_CONTEXTUAL_ASSOCIATION_ENDPOINT_LIMIT_LIGHT=1
MEMORY_CONTEXTUAL_ASSOCIATION_ENDPOINT_LIMIT_STANDARD=2
MEMORY_CONTEXTUAL_ASSOCIATION_ENDPOINT_LIMIT_DEEP=4
MEMORY_CONTEXTUAL_ASSOCIATION_MAX_CANDIDATES_PER_TURN=8
MEMORY_CONTEXTUAL_ASSOCIATION_PROBATION_LIMIT=10000
MEMORY_CONTEXTUAL_ASSOCIATION_PROBATION_TTL=2592000
MEMORY_CONTEXTUAL_ASSOCIATION_MIN_DISTINCT_SUCCESSES=2
MEMORY_CONTEXTUAL_ASSOCIATION_NOOP_DECAY=0.98
MEMORY_CONTEXTUAL_ASSOCIATION_HARM_MULTIPLIER=0.5
KNOWLEDGE_MEMORY_GROWTH_ENABLED=1
PUBLIC_MEMORY_GROWTH_ENABLED=1
USER_MEMORY_GROWTH_ENABLED=1
MEMORY_ASSOCIATION_CUE_ENABLED=0
MEMORY_ASSOCIATION_CUE_FAST_PATH_ENABLED=0
MEMORY_ASSOCIATION_CUE_FAST_PATH_MIN_SIMILARITY=0.62
MEMORY_ASSOCIATION_CUE_FAST_PATH_MIN_MARGIN=0.08
MEMORY_ASSOCIATION_CUE_FAST_PATH_MIN_CONFIDENCE=0.72
MEMORY_CONTEXT_MAX_CHARS=8000
# The intent planner receives the current message and only this bounded slice
# of recent conversation. Disable it to use the generic conservative fallback.
MEMORY_INTENT_ENABLED=true
MEMORY_INTENT_CONTEXT_MESSAGES=6
MEMORY_INTENT_CONTEXT_CHARS=4000
MEMORY_GROWTH_QUEUE_DIR="data/growth_queue"
BOT_PROCESS_LOCK_PATH="data/bot.lock"
MEMORY_GROWTH_QUEUE_MAX=100
MEMORY_GROWTH_MIN_CHARS=18
MEMORY_CONVERSATION_BATCH_EXCHANGES=4
MEMORY_CONVERSATION_BATCH_CHARS=3000
# Whole pass-1 extraction attempts per Source segment. Reasoning models may
# fall back after malformed JSON; the embedding model itself never falls back.
MEMORY_IMPORT_TASK_MAX_ATTEMPTS=2
# Administrative imports need a larger structured-output ceiling than runtime
# memory growth. This value is read by `python manage.py import` only.
KNOWLEDGE_IMPORT_REASONING_MAX_TOKENS=8000

# ----------------------------------------
# 2. 短期工作记忆限制 (Working Memory Limits)
# ----------------------------------------
# 数据库中为每个用户保留的短期聊天记录总条数（建议 20-50）
WORKING_MEMORY_WINDOW=20

# ----------------------------------------
# 3. 主程序并发与防抖 (Bot Concurrency & Debounce)
# ----------------------------------------
# 允许同时处理多少个用户的聊天请求（防止瞬间并发打爆 API）
BOT_MAX_CONCURRENCY=10
# 防抖等待时间（秒）。用户连续发多条消息时，等待几秒不再发，才合并为一条进行处理。
BOT_DEBOUNCE_WAIT=2.0

# 只记录模型、消息数量和字符数；不会记录 prompt/response 正文。
ENABLE_TRACE_LOGGING=false
# 仅在短时本机诊断时开启；会把完整模型输入输出写入主日志。
ENABLE_TRACE_CONTENT_LOGGING=false
# 仅在短时诊断记忆引擎时开启；会把完整模型载荷写入 JSONL。
MEMORY_LOG_MODEL_PAYLOADS=false

# Durable inbound-event deduplication shared by all adapters.
ADAPTER_EVENT_DB_PATH="data/adapter_events.db"
ADAPTER_EVENT_TTL_SECONDS=604800
ADAPTER_EVENT_LEASE_SECONDS=900

# ----------------------------------------
# 4. Optional chat adapters
# ----------------------------------------
# Install requirements-all-adapters.txt, or only the corresponding grouped
# requirements file. Disabled adapters do not require credentials.

ENABLE_DISCORD=false
DISCORD_WHITELIST_ENABLED=false
DISCORD_BOT_TOKEN=""
DISCORD_ALLOWED_USERS=""
DISCORD_ALLOWED_CHANNELS=""
DISCORD_ALLOWED_GUILDS=""
DISCORD_GUILD_MODE=mentions

ENABLE_SLACK=false
SLACK_WHITELIST_ENABLED=false
SLACK_BOT_TOKEN=""
SLACK_APP_TOKEN=""
SLACK_BOT_USER_ID=""
SLACK_ALLOWED_USERS=""
SLACK_ALLOWED_CHANNELS=""
SLACK_ALLOWED_TEAMS=""

ENABLE_TEAMS=false
TEAMS_WHITELIST_ENABLED=false
TEAMS_CLIENT_ID=""
TEAMS_TENANT_ID=""
TEAMS_CLIENT_SECRET=""
TEAMS_MANAGED_IDENTITY_CLIENT_ID=""
TEAMS_ALLOWED_USERS=""
TEAMS_ALLOWED_TENANTS=""
TEAMS_ALLOWED_CONVERSATIONS=""
TEAMS_GROUP_MODE=mentions
TEAMS_PORT=3978

ENABLE_LARK=false
LARK_WHITELIST_ENABLED=false
LARK_APP_ID=""
LARK_APP_SECRET=""
LARK_ALLOWED_USERS=""
LARK_ALLOWED_CHATS=""
LARK_GROUP_MODE=mentions

ENABLE_WECOM=false
WECOM_WHITELIST_ENABLED=false
WECOM_BOT_ID=""
WECOM_SECRET=""
WECOM_ALLOWED_USERS=""
WECOM_ALLOWED_CHATS=""

ENABLE_DINGTALK=false
DINGTALK_WHITELIST_ENABLED=false
DINGTALK_CLIENT_ID=""
DINGTALK_CLIENT_SECRET=""
DINGTALK_ALLOWED_USERS=""
DINGTALK_ALLOWED_CONVERSATIONS=""

ENABLE_QQ=false
QQ_WHITELIST_ENABLED=false
QQ_APP_ID=""
QQ_CLIENT_SECRET=""
QQ_ALLOWED_USERS=""
QQ_ALLOWED_CHATS=""
QQ_ALLOWED_SCOPES="c2c,group,guild"
QQ_GROUP_MODE=mentions

ENABLE_LINE=false
LINE_WHITELIST_ENABLED=false
LINE_CHANNEL_SECRET=""
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_ALLOWED_USERS=""
LINE_ALLOWED_CHATS=""
LINE_GROUP_MODE=mentions
LINE_WEBHOOK_HOST="0.0.0.0"
LINE_WEBHOOK_PORT=8080
LINE_WEBHOOK_PATH="/webhooks/line"

ENABLE_WHATSAPP=false
WHATSAPP_WHITELIST_ENABLED=false
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_GRAPH_API_VERSION="v25.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ALLOWED_USERS=""
WHATSAPP_ALLOWED_PHONE_NUMBER_IDS=""
WHATSAPP_WEBHOOK_HOST="0.0.0.0"
WHATSAPP_WEBHOOK_PORT=8081
WHATSAPP_WEBHOOK_PATH="/webhooks/whatsapp"

ENABLE_MESSENGER=false
MESSENGER_WHITELIST_ENABLED=false
MESSENGER_APP_SECRET=""
MESSENGER_VERIFY_TOKEN=""
MESSENGER_PAGE_ACCESS_TOKEN=""
MESSENGER_GRAPH_API_VERSION="v25.0"
MESSENGER_PAGE_ID=""
