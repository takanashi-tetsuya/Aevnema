MESSENGER_WEBHOOK_HOST="0.0.0.0"
MESSENGER_WEBHOOK_PORT=8082
MESSENGER_WEBHOOK_PATH="/webhooks/messenger"

ENABLE_GOOGLE_CHAT=false
GOOGLE_CHAT_WHITELIST_ENABLED=false
GOOGLE_CHAT_OIDC_AUDIENCE=""
GOOGLE_CHAT_SERVICE_ACCOUNT_FILE=""
GOOGLE_CHAT_APP_SCOPE=""
GOOGLE_CHAT_ALLOWED_USERS=""
GOOGLE_CHAT_ALLOWED_SPACES=""
GOOGLE_CHAT_ALLOWED_DOMAINS=""
GOOGLE_CHAT_SPACE_MODE=direct
GOOGLE_CHAT_WEBHOOK_HOST="0.0.0.0"
GOOGLE_CHAT_WEBHOOK_PORT=8083
GOOGLE_CHAT_WEBHOOK_PATH="/webhooks/google-chat"

ENABLE_XMPP=false
XMPP_WHITELIST_ENABLED=false
XMPP_JID=""
XMPP_PASSWORD=""
XMPP_HOST=""
XMPP_PORT=""
XMPP_ALLOWED_JIDS=""

ENABLE_MATRIX=false
MATRIX_WHITELIST_ENABLED=false
MATRIX_HOMESERVER=""
MATRIX_USER_ID=""
MATRIX_ACCESS_TOKEN=""
MATRIX_PASSWORD=""
MATRIX_DEVICE_ID=""
MATRIX_ALLOWED_USERS=""
